{
	"name": "binge",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"generate": "kubb generate",
		"generate:openapi": "kubb validate -i \"$PWD/openapi/tvmaze.yaml\"",
		"prepare": "lefthook install",
		"typecheck": "vue-tsc -b --noEmit && tsc -p tsconfig.test.json --noEmit"
	},
	"dependencies": {
		"@tanstack/vue-query": "^5.74.9",
		"@vueuse/core": "^14.2.1",
		"vue": "^3.5.33",
		"vue-router": "^5.0.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"@faker-js/faker": "^9.9.0",
		"@kubb/cli": "^4.37.4",
		"@kubb/core": "^4.37.4",
		"@kubb/plugin-client": "^4.37.4",
		"@kubb/plugin-faker": "4.37.4",
		"@kubb/plugin-msw": "^4.37.4",
		"@kubb/plugin-oas": "^4.37.4",
		"@kubb/plugin-ts": "^4.37.4",
		"@kubb/plugin-vue-query": "^4.37.4",
		"@tailwindcss/vite": "^4.2.4",
		"@tanstack/vue-query-devtools": "^5.74.9",
		"@types/node": "^25.6.0",
		"@vitejs/plugin-vue": "^6.0.6",
		"@vue/tsconfig": "^0.9.1",
		"lefthook": "^2.1.6",
		"msw": "^2.14.2",
		"tailwindcss": "^4.2.4",
		"typescript": "~6.0.3",
		"vite": "^8.0.10",
		"vue-tsc": "^3.2.7"
	}
}
