{
	"name": "binge",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=22"
	},
	"msw": {
		"workerDirectory": "public"
	},
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"generate": "kubb generate",
		"generate:openapi": "kubb validate -i \"$PWD/openapi/tvmaze.yaml\"",
		"prepare": "lefthook install",
		"typecheck": "vue-tsc -b --noEmit",
		"test": "vitest run",
		"test:browser": "vitest run --browser.headless=false",
		"test:watch": "vitest",
		"test:install-browsers": "playwright install chromium"
	},
	"dependencies": {
		"@tanstack/vue-query": "^5.74.9",
		"lucide-vue-next": "^1.0.0",
		"tw-animate-css": "^1.4.0",
		"vue": "^3.5.33",
		"vue-router": "^5.0.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"@faker-js/faker": "^9.9.0",
		"@kubb/cli": "^4.37.4",
		"@kubb/core": "^4.37.4",
		"@kubb/plugin-client": "^4.37.4",
		"@kubb/plugin-faker": "4.37.4",
		"@kubb/plugin-msw": "^4.37.4",
		"@kubb/plugin-oas": "^4.37.4",
		"@kubb/plugin-ts": "^4.37.4",
		"@kubb/plugin-vue-query": "^4.37.4",
		"@tailwindcss/vite": "^4.2.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/user-event": "^14.6.1",
		"@testing-library/vue": "^8.1.0",
		"@types/node": "^25.6.0",
		"@vitejs/plugin-vue": "^6.0.6",
		"@vitest/browser-playwright": "^4.1.5",
		"@vue/tsconfig": "^0.9.1",
		"lefthook": "^2.1.6",
		"msw": "^2.14.2",
		"playwright": "^1.59.1",
		"tailwindcss": "^4.2.4",
		"typescript": "~6.0.3",
		"vite": "^8.0.10",
		"vitest": "^4.1.5",
		"vue-tsc": "^3.2.7"
	}
}
